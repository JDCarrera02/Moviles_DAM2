<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imagen_perro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:src="@drawable/perro" />

    <TextView
        android:id="@+id/texto_pregunta"
        android:layout_margin="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pregunta_edad"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/lima"/>

    <EditText
        android:id="@+id/edit_edad"
        android:layout_marginHorizontal="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="@string/introduce_tu_edad"
        android:inputType="number"/>

    <Button
        android:id="@+id/boton_calcular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginVertical="16dp"
        android:backgroundTint="@color/lima"
        android:text="@string/calcular"
        android:textSize="20sp"/>

    <TextView
        android:id="@+id/texto_respuesta"
        android:layout_margin="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="Si fueras un perro, tendrías 47 años"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/lima"/>


</LinearLayout>