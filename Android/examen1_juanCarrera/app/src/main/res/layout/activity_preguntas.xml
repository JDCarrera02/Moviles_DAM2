<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_preguntas"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/azul_personalizado_2_celeste"
    tools:context=".PreguntasActivity">

    <TextView
        android:id="@+id/preguntas_titulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="54dp"
        android:text="@string/intro_titulo"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/label_progreso"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="136dp"
        android:layout_marginTop="36dp"
        android:textStyle="bold"
        android:textColor="@color/azul_personalizado_4"
        android:background="@color/azul_personalizado_3"
        app:layout_constraintStart_toStartOf="@+id/preguntas_titulo"
        app:layout_constraintTop_toBottomOf="@+id/preguntas_titulo"
        tools:text="@string/preg_progreso_texto" />

    <TextView
        android:id="@+id/label_enunciado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="#ABFFFFFF"
        android:padding="12dp"
        android:textAlignment="center"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/label_progreso"
        tools:text="Enunciado" />

    <RadioGroup
        android:id="@+id/grupo_botones"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/label_enunciado"
        app:layout_constraintStart_toStartOf="@+id/label_enunciado"
        app:layout_constraintTop_toBottomOf="@+id/label_enunciado">

        <RadioButton
            android:id="@+id/opcion_a"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:background="#ABFFFFFF"
            android:layout_marginTop="12dp"
            android:textStyle="bold"
            tools:text="opcion a" />

        <RadioButton
            android:id="@+id/opcion_b"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="12dp"
            android:textStyle="bold"
            android:background="#ABFFFFFF"
            tools:text="opcion b" />

        <RadioButton
            android:id="@+id/opcion_c"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="12dp"
            android:textStyle="bold"
            android:background="#ABFFFFFF"
            tools:text="opcion c" />

        <RadioButton
            android:id="@+id/opcion_d"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:background="#ABFFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            tools:text="opcion d" />
    </RadioGroup>

    <Button
        android:id="@+id/boton_comprobar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="@string/texto_boton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>